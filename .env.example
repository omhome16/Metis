# ── App ────────────────────────────────────────────────────────────────
METIS_ENV=dev                      # dev | test | prod
METIS_LOG_LEVEL=INFO
METIS_API_PREFIX=/api/v1

# ── Databases (match docker-compose.yml) ──────────────────────────────
METIS_DB_URL=postgresql+asyncpg://metis:metis@localhost:6433/metis   # host 6433 → container 5432
METIS_REDIS_URL=redis://localhost:6379/0
METIS_NEO4J_URI=bolt://localhost:7687
METIS_NEO4J_USER=neo4j
METIS_NEO4J_PASSWORD=metis-dev-password

# ── LLM gateway ───────────────────────────────────────────────────────
# Get a key at https://console.groq.com ; leave empty to use the mock fallback.
GROQ_API_KEY=
# Get a key at https://aistudio.google.com/apikey ; leave empty to use the mock fallback.
GEMINI_API_KEY=
METIS_PRIMARY_PROVIDER=groq        # groq | gemini
METIS_GENERATION_MODEL=llama-3.3-70b-versatile
METIS_FAST_MODEL=llama-3.1-8b-instant
METIS_VISION_MODEL=gemini-flash-latest
METIS_EXTRACTION_MODEL=gemini-flash-latest
# Per-task provider overrides (P7): route judge/extraction off the default
# gemini when its free tier is rate-limited. Values: groq | gemini | ollama.
METIS_JUDGE_PROVIDER=gemini
METIS_EXTRACTION_PROVIDER=gemini
METIS_MAX_TOKENS=1024

# Local LLM via ollama (P6): OpenAI-compatible endpoint on your machine.
# Set METIS_OLLAMA_MODEL (e.g. qwen3:8b, llama3.1:8b) to enable; empty = disabled.
# Runs on CPU — model size is the main cost driver. Mock stays the default fallback.
METIS_OLLAMA_BASE_URL=http://localhost:11434/v1
METIS_OLLAMA_MODEL=
METIS_OLLAMA_TOOLS=false               # true only for tool-capable tags

# OCR (P6): OCR zero-text PDFs at ingest. Requires the tesseract binary on PATH
# (https://github.com/tesseract-ocr/tesseract). Empty = zero-text PDFs are
# marked `extraction_status=empty` with an ingest warning (never silent).
METIS_OCR_ENGINE=

# ── Judgment layer (TypeSafe System One / Jev) ────────────────────────
# Metis *generates* text with the LLM gateway above and *decides* with a
# judgment model. Jev returns typed answers and calibrated probabilities
# instead of text, so verification tasks can threshold in code.
# Input $0.042/Mtok; output tokens are free. Docs: https://docs.typesafe.ai
# Key: https://console.typesafe.ai (canonical unprefixed name below).
# backend: llm (default — the pre-existing LLM judges) | typesafe | mock | off
METIS_JUDGMENT_BACKEND=llm
TYPESAFE_API_KEY=
METIS_TYPESAFE_MODEL=jev-latest
# A Noul within this distance of 0.5 reads as "similar probability either way",
# not "medium intensity" → escalate to the LLM judge rather than acting on it.
METIS_JUDGMENT_NOUL_UNCERTAIN_BAND=0.15
METIS_JUDGMENT_CONTRADICTION_THRESHOLD=0.5

# ── Local models (free, offline) ──────────────────────────────────────
METIS_EMBED_MODEL=BAAI/bge-m3              # 1024-dim, multilingual (heavy ~2.3GB)
# METIS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # fast dev option (384-dim)
METIS_EMBED_DIM=1024
METIS_RERANK_MODEL=BAAI/bge-reranker-base
METIS_CLIP_MODEL=clip-ViT-B-32             # 512-dim image embeddings
METIS_CLIP_DIM=512

# ── Retrieval / chunking ──────────────────────────────────────────────
METIS_CHUNK_SIZE=700
METIS_CHUNK_OVERLAP=100
METIS_TOP_K_VECTOR=10
METIS_TOP_K_KEYWORD=10
METIS_TOP_K_GRAPH=10
METIS_RERANK_CANDIDATES=20
METIS_TOP_K_RERANK=5
METIS_CACHE_SIMILARITY_THRESHOLD=0.92
# Near-duplicate guard on cache hits (P8): a hit must also share >= min_jaccard
# of tokens and stay within max_len_ratio — blocks entity-swapped near-identical
# questions from sharing an answer.
METIS_CACHE_MIN_JACCARD=0.8
METIS_CACHE_MAX_LEN_RATIO=1.5

# ── Parent-child chunking (P3.1) ──────────────────────────────────────
METIS_PARENT_CHILD=true
METIS_PARENT_SIZE=2000
METIS_CHILD_SIZE=400
METIS_CHILD_OVERLAP=60

# ── Pipeline toggles ──────────────────────────────────────────────────
METIS_QUERY_REWRITE=true         # LLM rewrite vague queries before retrieval
METIS_METADATA_FILTER=true       # LLM extracts tags/date/author filters from the query
METIS_RERANK_ENABLED=true
METIS_ROUTER_LLM=false           # one extra LLM call to refine the router's lane

# ── Graph extraction + self-organization (P8, runtime-settable via /settings) ──
METIS_GRAPH_EXTRACTION_MODE=t1   # t1 local regex | t2 +LLM windows | t3 LLM per parent
METIS_GRAPH_EXTRACT_WINDOWS=3    # sampled windows for t2
METIS_GRAPH_REORG_AUTO=true
METIS_GRAPH_REORG_POLICY=debounced   # batch | debounced | nightly
METIS_GRAPH_REORG_MIN_DOCS=3

# ── Observability / limits ─────────────────────────────────────────────────
# Langfuse tracing is optional — leave blank to disable (no-ops gracefully).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
METIS_RATE_LIMIT_MAX=120
METIS_RATE_LIMIT_WINDOW=60

# ── Access control (see app/core/security.py) ─────────────────────────
# Empty = no auth (the localhost / single-user default). Set this before
# exposing Metis on a public URL: without it any visitor can delete the library
# and spend the LLM quota. A shared secret, not a user system — the SPA prompts
# for it once and stores it in localStorage. Accepted as `Authorization: Bearer`,
# `X-API-Token`, or `?token=` (the last one for browser downloads, which cannot
# send headers). Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
METIS_API_TOKEN=
# Trust X-Forwarded-For when bucketing the rate limit. Enable ONLY behind a
# reverse proxy that overwrites the header, or clients can forge their bucket.
METIS_TRUST_PROXY_HEADERS=false
# Comma-separated origins in prod; "*" (dev default) disallows credentialed CORS.
METIS_CORS_ORIGINS=*
